# HKGAI Studio credentials (from the hackathon dashboard).
# Copy to .env.local — never commit .env.local.

# Modelhub text models (OpenAI-compatible). Base URL should end at the
# API root, e.g. https://<modelhub-host>/v1
HKGAI_BASE_URL=
HKGAI_API_KEY=
HKGAI_CHAT_MODEL=hkgai-v1

# Modelhub speech (31-day token, renewable). Leave empty to use the
# browser's zh-HK voice as a fallback during development.
HKGAI_SPEECH_URL=
HKGAI_SPEECH_TOKEN=

# TTS voice for /api/tts and scripts/generate-phrase-audio.mjs
# model: tts-v1 | tts-v2 · voice: female | male
HKGAI_TTS_MODEL=tts-v1
HKGAI_TTS_VOICE=female

# Toolhub / Agenthub (REST + MCP)
# Toolhub REST base defaults to https://toolhub.prod.hkchat.app/v1
HKGAI_APP_NAME=
HKGAI_APP_KEY=
