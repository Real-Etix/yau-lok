# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the placeholder template, which is how anyone else runs this
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local editor/agent config
.claude/

# Submission and production material. This repository is the application: it
# should clone, install and run, and nothing more. Pitch scripts, decks,
# narration, screen recordings and the finished videos all live on disk but
# are deliberately not part of it.
submission/
public/pitch.html
public/menu-board.html
public/shots/
*.mp4
*.mov
*.m4a
*.wav
# ...except the app's own pre-rendered Cantonese, which it needs to run.
!public/audio/*.wav

# internal design handoffs, not part of the product
design_handoff_gmb_green_theme*/
